# === Protocolo 190 / demo (copie para o .env da raiz do J.A.R.V.I.S.) ===

# Contato de confiança no WhatsApp — DDI+DDD+número, só dígitos (sem +)
# Exemplo Rio Preto: 5517999999999
EMERGENCY_CONTACT_PHONE=5517999999999

# Nome do contato como aparece no WhatsApp (ajuda a localizar na busca)
EMERGENCY_CONTACT_NAME=Maria

# Endereço completo usado na mensagem de socorro
HOME_ADDRESS=Rua São Luiz, nº 244, Jardim Europa, São José do Rio Preto - SP

# --- App de câmeras (desktop) ---
# Nome como no menu Iniciar (open_app)
CAMERA_APP_NAME=Hik-Connect
# Caminho opcional do .exe se o nome não bastar
# CAMERA_APP_PATH=C:\Program Files\Hikvision\Hik-Connect\Hik-Connect.exe

# --- OU app de câmeras via navegador (Web) ---
# Se definido, abre a URL com o navegador em vez do executável
# CAMERA_APP_URL=https://web.sua-dvr.local/

# Segundos para esperar a UI das câmeras carregar antes do print
CAMERA_LOAD_DELAY_SEC=3

# --- Suítes 24/7 (sentinel / smart_home / daily_ops / telegram) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WATCHDOG_INTERNET_AUTO=0
TUYA_DEVICE_ID=
TUYA_IP=
TUYA_LOCAL_KEY=
TUYA_VERSION=3.3
WOL_MAC=AA:BB:CC:DD:EE:FF
WOL_BROADCAST=255.255.255.255

KAGGLE_USERNAME="dev4jarvis"
KAGGLE_KEY="your_kaggle_key"

# --- MCP / integrações ---
GITHUB_TOKEN=
YOUTUBE_API_KEY=
OBS_WS_HOST=127.0.0.1
OBS_WS_PORT=4455
OBS_WS_PASSWORD=
OLLAMA_HOST=http://127.0.0.1:11434

# --- MCP & INTEGRAÇÕES EXTERNAS / LOCAIS ---

# GitHub API (https://github.com → Settings → Developer settings → PAT)
GITHUB_TOKEN=

# YouTube Data API v3 (https://console.cloud.google.com)
YOUTUBE_API_KEY=

# OBS Studio WebSocket v5 (ws://127.0.0.1:4455 | OBS → Ferramentas → WebSocket)
OBS_WS_HOST=127.0.0.1
OBS_WS_PORT=4455
OBS_WS_PASSWORD=

# Ollama LLM Local
OLLAMA_HOST=http://127.0.0.1:11434

# Modelo referência: 42M8QA24M5 (ar_quarto)

